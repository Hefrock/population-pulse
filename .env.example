# Copy this file to .env and fill in your keys. The .env file is gitignored
# and should never be committed. In CI, these are stored as GitHub Secrets.

# MBTA V3 API — free key from https://api-v3.mbta.com/
MBTA_API_KEY=your_mbta_key_here

# Ticketmaster Discovery API — free key from https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=your_ticketmaster_key_here
